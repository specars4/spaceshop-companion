<Configuration>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\LOCAL_PROJECTS\spaceshop-companion\smoke</HostFolder>
      <SandboxFolder>C:\smoke</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -ExecutionPolicy Bypass -File C:\smoke\run.ps1</Command>
  </LogonCommand>
</Configuration>
