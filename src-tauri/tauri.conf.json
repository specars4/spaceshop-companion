{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spaceshop Companion",
  "version": "0.6.6",
  "identifier": "studio.spaceshop.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spaceshop Companion",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/p4.exe": "binaries/p4.exe",
      "binaries/tailscale.msi": "binaries/tailscale.msi"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "A375930A-7832-41CE-B9F1-B3BF70C9C073",
        "fragmentPaths": ["wix/fragment.wxs"],
        "componentRefs": ["CompanionCloseAppAnchor"]
      }
    },
    "shortDescription": "Connect to Spaceshop projects",
    "longDescription": "One-click access to Spaceshop Studios projects. Paste an invite from your project lead and the rest is automatic.",
    "publisher": "Spaceshop Studios",
    "copyright": "Spaceshop Studios Inc.",
    "category": "Productivity"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spaceshop-companion"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/specars4/onboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNzMzQzE5QkIwODkwQkIKUldTN2tBaTdHVHh6ODhpbUQvU3BjcHU2NGxmWUxIOHdJNnNFbWE0WXRsbGVob2JxV0ZORjRTcWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
